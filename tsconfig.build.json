{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "./dist/types",
    "rootDir": "./src",
    "sourceMap": false
  },
  "include": ["src/index.ts", "src/core/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "node_modules", "dist", "tests"]
}
